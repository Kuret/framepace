#!/usr/bin/env python3
"""fps-cap: live fps cap and overlay control for games running through the framepace Vulkan layer.

Usage:
  fps-cap [--game KEY] up|down [n]     raise or lower the cap by n (default 1); manual mode
  fps-cap [--game KEY] set <fps>       set the cap; manual mode
  fps-cap [--game KEY] off             no cap from framepace (overlay only)
  fps-cap [--game KEY] adaptive [on|off|toggle]
  fps-cap [--game KEY] overlay [on|off|toggle]
  fps-cap [--game KEY] status          the target game
  fps-cap list                         running games and saved per-game settings
  fps-cap daemon                       adaptive controller (normally run by framepace.service)
  fps-cap --help

Every game process that runs with the framepace layer active has a live state file,
~/.local/state/framepace/run/<pid>.state, holding its cap, mode flags, overlay flag and per-frame
timing. The cap is a single write to that file; the next frame uses it. Each game is identified
by a key (steam-<appid>, or the executable name) and its settings are saved in
~/.config/framepace/games/<key>.conf, which the layer reads when the game starts:
  mode = adaptive|manual|off     cap = N (manual cap)     overlay = on|off     last_adaptive = N
fps-cap is the only writer of those files. up/down/set/off/adaptive/overlay update the game's live
state and its saved settings; the daemon saves last_adaptive (at most every 15 s, on pause and when
the game exits).

Target game for commands and the daemon, unless --game is given: with Hyprland, the fullscreen
active window's game; otherwise the game that presented most recently. With --game KEY for a game
that is not running, only its saved settings change.

Adaptive mode follows the target game. The layer reports, per frame, how long it took from
release to finished rendering (CPU and GPU together). The cap follows the slow tail of those
times, so it sits where nearly every frame fits: the 99th percentile of the last 30 s and the 95th
of the last 2 s (whichever needs the lower cap), plus a 5% margin. Busy scenes such as crowds show
up as a heavier tail and lower the cap at once. An uncapped adaptive game starts at MAX_CAP. A
target 10+ fps above the cap is climbed to after a 2 s hold at +1 per 0.1 s, a closer one after a
5 s hold at +1 per 0.5 s. Single frames over 100 ms (loading) are left out of the tail, and so
is any stretch where the median present interval over the last second exceeds twice the cap's
interval and 25 ms (loading screens, menus with stalls): nothing is decided then. After every
transition (new game, resume after a pause, end of such a stretch, a frame gap) it settles for 10 s:
frames are not measured, nothing climbs, and only the late-frame backup may lower the cap. As a backup, more than 5%
modestly late frames in a second drops the cap to just under what the game achieved. last_adaptive
is the time-weighted 75th percentile of the cap over the last 5 minutes of representative play,
not the value at exit.
The daemon pauses when no new frame arrived for 1 s or (Hyprland only, optional) the active window
is not fullscreen; a frame gap over 250 ms (alt-tab, loading) is a break and restarts the
measurement window. Other running games keep their caps. Dead run files are removed.

Configuration: ~/.config/framepace/config, "key = value" lines:
  MIN_CAP = 50      lowest cap adaptive/manual will set; put it just above your monitor's VRR floor
  MAX_CAP = 0       highest cap; 0 = auto: refresh - refresh^2/3600 (144 Hz -> 138), refresh taken
                    from the fastest connected output (hyprctl, wlr-randr, xrandr; else 138)
  MARGIN = 1.05     cap = 1000 / (tail work time * MARGIN)
  DEFAULT_MODE = adaptive     for games without saved settings: adaptive, manual or off
  DEFAULT_OVERLAY = on        for games without saved settings
  PAUSE_WHEN_NOT_FULLSCREEN = yes   Hyprland only: pause adapting while the active window is not
                    fullscreen (ignored when hyprctl or its environment is not available)
"""
import glob
import json
import mmap
import os
import re
import shutil
import struct
import subprocess
import sys
import time

STATE_DIR = os.path.expanduser("~/.local/state/framepace")
RUN_DIR = os.path.join(STATE_DIR, "run")
OLD_STATE = os.path.join(STATE_DIR, "state")        # layout v1, replaced by per-process run files
GAMES_DIR = os.path.expanduser("~/.config/framepace/games")
LOG = os.path.expanduser("~/.cache/framepace/fps-cap.log")
CONFIG = os.path.expanduser("~/.config/framepace/config")
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "fps-cap.pid")

# run file layout v2, see README.md
MAGIC, VERSION, RING = 0x43415046, 2, 256
HEADER = struct.Struct("<IIiIQIIQ64s")  # magic, version, cap, flags, seq, head, pid, last_present_ns, game
FRAME = struct.Struct("<QII")           # present_ns, frame_ns, work_ns
OFF_CAP, OFF_FLAGS = 8, 12
SIZE = HEADER.size + RING * FRAME.size
OVERLAY, ADAPTIVE, MANUAL = 1, 2, 4
KEY_RE = re.compile(r"^[A-Za-z0-9_-][A-Za-z0-9._-]{0,62}$")

# configurable (see the config file)
MIN_CAP = 50                    # just above the VRR floor (frames collide right at it)
MAX_CAP = 0                     # 0 = auto from the monitor refresh
MARGIN = 1.05                   # cap = 1000 / (tail work * MARGIN)
DEFAULT_MODE = "adaptive"
DEFAULT_OVERLAY = True
PAUSE_WHEN_NOT_FULLSCREEN = True
FALLBACK_MAX = 138              # when the refresh rate cannot be detected (144 Hz)

TICK = 0.25                     # seconds between decisions
TAIL_LONG, TAIL_LONG_Q = 30.0, 0.99   # window (s) and percentile of frame work the cap must fit; crowds burst every ~20-30 s
TAIL_SHORT, TAIL_SHORT_Q = 2.0, 0.95  # a short window, so walking into a crowd lowers the cap within ~1-2 s
LOADING_MS = 100                # frames slower than this are loading hitches, not the scene's load
RISE_HOLD, RISE_STEP = 5.0, 0.5 # target must stay above the cap this long; then +1 per RISE_STEP s
CLIMB_FAR_GAP = 10              # target this far above the cap (fps): climb fast ...
RISE_HOLD_FAR, RISE_STEP_FAR = 2.0, 0.1   # ... after a shorter hold, +1 per 0.1 s
UNREP_FACTOR = 2.0              # a stretch is unrepresentative (loading, login, zoning, menus with stalls)
                                # when the median present interval over the last second is more than this
                                # many times the cap's interval, i.e. the game delivers under half the cap,
UNREP_MIN_MS = 25.0             # ... and is also slower than this (under 40 fps). Loading screens and stalls
                                # are far slower; a heavy game playing at 45-60 fps must still get capped,
                                # instead of staying in this state at a high starting cap
SETTLE_S = 10.0                 # after every transition (new game, resume after a pause, end of a stretch,
                                # frame gap) frames are not measured and only the late-frame backup may
                                # lower the cap, nothing climbs. Login and loading screens mix normal frames
                                # with 20-40 ms spikes: the median looks fine, but the spikes would enter the
                                # 30 s tail, pin the cap at the minimum and keep it there until they age out.
                                # Restarts when another transition happens inside it.
REP_WINDOW_S = 300.0            # last_adaptive: look at the cap over this much recent play ...
REP_QUANTILE = 0.75             # ... and save this (time-weighted) percentile of it, not the value at exit
REP_MIN_S = 30.0                # with less representative play than this, the saved value is left alone
LATE_FACTOR, LATE_SLACK_MS = 1.10, 1.0
HITCH = 1.6                     # backup rule: present intervals between deadline and HITCH intervals are late
DROP_AT = 0.05                  # ... and more than this fraction of them in the last second drops the cap
STALL_S = 1.0                   # no new frames for this long: the game is not running/visible, pause
BREAK_MS = 250                  # a frame gap this long (alt-tab, loading) is a break: restart the windows
PERSIST_S = 15.0                # save last_adaptive at most this often while running


# --- configuration ----------------------------------------------------------------------------

def load_config():
    global MIN_CAP, MAX_CAP, MARGIN, PAUSE_WHEN_NOT_FULLSCREEN, DEFAULT_MODE, DEFAULT_OVERLAY
    try:
        lines = open(CONFIG).read().splitlines()
    except OSError:
        return
    for n, line in enumerate(lines, 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        key, sep, val = (p.strip() for p in line.partition("="))
        try:
            if not sep:
                raise ValueError("expected key = value")
            key = key.upper()
            if key == "MIN_CAP":
                MIN_CAP = max(1, int(val))
            elif key == "MAX_CAP":
                MAX_CAP = max(0, int(val))
            elif key == "MARGIN":
                MARGIN = float(val)
                if MARGIN <= 0:
                    raise ValueError("must be > 0")
            elif key == "PAUSE_WHEN_NOT_FULLSCREEN":
                PAUSE_WHEN_NOT_FULLSCREEN = val.lower() in ("1", "yes", "true", "on")
            elif key == "DEFAULT_MODE":
                if val.lower() not in ("adaptive", "manual", "off"):
                    raise ValueError("expected adaptive, manual or off")
                DEFAULT_MODE = val.lower()
            elif key == "DEFAULT_OVERLAY":
                DEFAULT_OVERLAY = val.lower() in ("1", "yes", "true", "on")
            else:
                raise ValueError("unknown key")
        except ValueError as e:
            print(f"fps-cap: {CONFIG}:{n}: {e}: {line!r}", file=sys.stderr)


def _run(cmd, timeout=3):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def detect_refresh():
    """highest refresh rate (Hz) among connected outputs, or None"""
    rates = []
    if shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        try:
            rates = [float(m["refreshRate"]) for m in json.loads(_run(["hyprctl", "monitors", "-j"]) or "[]")
                     if not m.get("disabled")]
        except (ValueError, KeyError, TypeError):
            rates = []
    if not rates and shutil.which("wlr-randr"):
        out = _run(["wlr-randr", "--json"])
        try:
            for o in json.loads(out or "[]"):
                if o.get("enabled", True):
                    rates += [float(m["refresh"]) for m in o.get("modes", []) if m.get("current")]
        except (ValueError, KeyError, TypeError):
            rates = []
        if not rates:
            rates = [float(r) for r in re.findall(r"([\d.]+) Hz[^\n]*current", _run(["wlr-randr"]))]
    if not rates and shutil.which("xrandr"):
        rates = [float(r) for r in re.findall(r"(\d+(?:\.\d+)?)\*", _run(["xrandr"]))]
    rates = [r for r in rates if r > 0]
    return max(rates) if rates else None


_max_cache = (0.0, FALLBACK_MAX)


def max_cap():
    """MAX_CAP from the config, or refresh - refresh^2/3600 (cached 30 s)"""
    global _max_cache
    if MAX_CAP > 0:
        return max(MAX_CAP, MIN_CAP)
    if time.monotonic() - _max_cache[0] > 30:
        hz = detect_refresh()
        _max_cache = (time.monotonic(), int(hz - hz * hz / 3600) if hz else FALLBACK_MAX)
    return max(_max_cache[1], MIN_CAP)


def clamp_cap(cap):
    return max(MIN_CAP, min(max_cap(), cap))


# --- saved per-game settings ------------------------------------------------------------------

def valid_key(key):
    return bool(KEY_RE.match(key)) and not key.startswith(".")


def conf_path(key):
    return os.path.join(GAMES_DIR, key + ".conf")


def read_conf(key):
    """saved settings of a game as {key: value}; missing or unreadable file = {}"""
    out = {}
    try:
        for line in open(conf_path(key)).read().splitlines():
            line = line.split("#", 1)[0].strip()
            k, sep, v = (p.strip() for p in line.partition("="))
            if sep and k:
                out[k.lower()] = v
    except OSError:
        pass
    return out


def write_conf(key, updates):
    """set keys in a game's .conf, keeping its other lines (atomic replace)"""
    path = conf_path(key)
    try:
        lines = open(path).read().splitlines()
    except OSError:
        lines = []
    pending = dict(updates)
    for i, line in enumerate(lines):
        k = line.split("#", 1)[0].partition("=")[0].strip().lower()
        if k in pending:
            lines[i] = f"{k} = {pending.pop(k)}"
    lines += [f"{k} = {v}" for k, v in pending.items()]
    os.makedirs(GAMES_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, path)


def saved_keys():
    return sorted(os.path.basename(p)[:-5] for p in glob.glob(os.path.join(GAMES_DIR, "*.conf")))


def effective_settings(key):
    """saved settings over the DEFAULT_* values: (mode, manual cap, overlay, last_adaptive)"""
    c = read_conf(key)
    mode = c.get("mode", DEFAULT_MODE).lower()
    overlay = c.get("overlay", "on" if DEFAULT_OVERLAY else "off").lower() in ("1", "yes", "true", "on")
    try:
        cap = int(c.get("cap", 0))
    except ValueError:
        cap = 0
    try:
        last = int(c.get("last_adaptive", 0))
    except ValueError:
        last = 0
    return mode if mode in ("adaptive", "manual", "off") else "adaptive", cap, overlay, last


# --- live state (run files) -------------------------------------------------------------------

def pid_alive(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class Run:
    """one game process's run file"""

    def __init__(self, path):
        self.path = path
        fd = os.open(path, os.O_RDWR)
        try:
            if os.fstat(fd).st_size < SIZE:
                raise ValueError("short run file")
            self.m = mmap.mmap(fd, SIZE)
        finally:
            os.close(fd)
        magic, version = struct.unpack_from("<II", self.m, 0)
        if (magic, version) != (MAGIC, VERSION):
            self.m.close()
            raise ValueError("not a v2 run file")

    def header(self):
        _, _, cap, flags, seq, head, pid, last_ns, game = HEADER.unpack_from(self.m, 0)
        return cap, flags, seq, head, pid, last_ns, game

    @property
    def cap(self):
        return self.header()[0]

    @property
    def flags(self):
        return self.header()[1]

    @property
    def seq(self):
        return self.header()[2]

    @property
    def pid(self):
        return self.header()[4]

    @property
    def last_ns(self):
        return self.header()[5]

    @property
    def key(self):
        return self.header()[6].split(b"\0")[0].decode("ascii", "replace")

    def set_cap(self, cap):
        cap = clamp_cap(cap)
        struct.pack_into("<i", self.m, OFF_CAP, cap)
        return cap

    def set_raw_cap(self, cap):
        struct.pack_into("<i", self.m, OFF_CAP, cap)

    def set_flags(self, on=0, off=0):
        struct.pack_into("<I", self.m, OFF_FLAGS, (self.flags | on) & ~off)

    def set_mode(self, adaptive):
        self.set_flags(on=ADAPTIVE if adaptive else MANUAL, off=MANUAL if adaptive else ADAPTIVE)

    def frames_since(self, seq_seen):
        """frames presented since seq_seen as (present_ns, frame_ns, work_ns), the current seq and writer pid"""
        _, _, seq, head, pid, _, _ = self.header()
        n = max(min(seq - seq_seen, RING), 0) if seq_seen else 0
        frames = [FRAME.unpack_from(self.m, HEADER.size + ((head - i) % RING) * FRAME.size)
                  for i in range(n - 1, -1, -1)]
        return frames, seq, pid

    def recent_fps(self):
        """mean fps over the last ~0.5 s of frames, None when idle"""
        cap, flags, seq, head, pid, last_ns, game = self.header()
        if not seq or time.monotonic_ns() - last_ns > 2e9:
            return None
        vals = []
        for i in range(min(seq, RING)):
            ns = FRAME.unpack_from(self.m, HEADER.size + ((head - i) % RING) * FRAME.size)[1]
            if ns:
                vals.append(ns)
                if sum(vals) >= 5e8:
                    break
        return 1e9 * len(vals) / sum(vals) if vals else None

    def mode(self):
        cap, flags = self.header()[:2]
        if flags & ADAPTIVE:
            return "adaptive"
        return "off" if cap == 0 else "manual"


def scan_runs(cache):
    """live runs, newest file state; run files of dead pids are removed"""
    live = {}
    for path in glob.glob(os.path.join(RUN_DIR, "*.state")):
        run = cache.get(path)
        if run is None:
            try:
                run = Run(path)
            except (OSError, ValueError):
                continue
        pid = run.pid
        if not pid_alive(pid):
            try:
                os.unlink(path)
            except OSError:
                pass
            run.m.close()
            cache.pop(path, None)
            continue
        cache[path] = run
        live[path] = run
    for path in [p for p in cache if p not in live]:
        cache.pop(path).m.close()
    return list(live.values())


def migrate():
    """the single v1 state file is gone; remove it"""
    try:
        os.unlink(OLD_STATE)
    except OSError:
        pass


# --- target selection --------------------------------------------------------------------------

def hypr_active():
    """the active window as a dict, or None without Hyprland"""
    if not (shutil.which("hyprctl") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")):
        return None
    try:
        w = json.loads(_run(["hyprctl", "activewindow", "-j"], timeout=2) or "{}")
    except ValueError:
        return None
    return w if isinstance(w, dict) else None


def is_descendant(pid, ancestor):
    for _ in range(12):
        if pid == ancestor:
            return True
        try:
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rpartition(")")[2].split()[1])
        except (OSError, ValueError, IndexError):
            return False
        if pid <= 1:
            return False
    return False


def pick_by_window(runs, window):
    """the game of the fullscreen active window (Hyprland), if it has a run file"""
    if window and window.get("fullscreen") and window.get("pid"):
        for r in runs:
            if is_descendant(r.pid, window["pid"]):
                return r
    return None


def pick_target(runs, window=None):
    """the fullscreen active window's game (Hyprland), else the most recent presenter"""
    if not runs:
        return None
    return pick_by_window(runs, window) or max(runs, key=lambda r: r.last_ns)


def not_fullscreen(window):
    """Optional Hyprland nicety: True when the active window is known not to be fullscreen."""
    return bool(PAUSE_WHEN_NOT_FULLSCREEN and window is not None and not window.get("fullscreen"))


def log(text):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + text
    print(line, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def notify(text):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "fps-cap", "-t", "1500", text],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --- adaptive controller --------------------------------------------------------------------

def persist_adaptive(run_key, cap, persisted):
    if cap > 0 and persisted.get(run_key) != cap:
        try:
            write_conf(run_key, {"last_adaptive": cap})
            persisted[run_key] = cap
        except OSError as e:
            log(f"cannot save settings for {run_key}: {e}")


class Tracker:
    """measurement state for one followed game"""

    def __init__(self, run):
        self.run = run
        self.key = run.key            # the run file (and its mapping) may be gone when we need it
        self.samples = []              # (ns, cap, seconds) of representative, active play
        self.last_sample_ns = None
        self.reset()

    def reset(self):
        """a new measurement window (target switch, pause, frame gap)"""
        self.frames = []               # (present_ns, frame_ns, work_ns) of the last TAIL_LONG seconds
        self.in_stretch = False
        self.settle_until = 0          # frames presented before this are not measured (settle period)
        self.settling = False
        self.cap_changes = []          # (ns, cap before, cap after) of recent daemon changes
        self.above_since = None
        self.climb_from = None         # when the next climb step is due
        self.climb = None              # cap where the current climb burst started
        self.last_sample_ns = None

    def representative(self):
        """frames the tails may use: only those presented after the settle period"""
        return [f for f in self.frames if f[0] >= self.settle_until]

    def start_settle(self, now_ns, reason):
        """a transition: measure nothing for SETTLE_S (restarts if already settling)"""
        self.settle_until = now_ns + int(SETTLE_S * 1e9)
        self.above_since = None
        self.last_sample_ns = None
        if not self.settling:
            self.settling = True
            log(f"settling for {SETTLE_S:g} s ({reason})")

    def end_climb(self, cap, why):
        if self.climb is not None:
            log(f"climb {why}: {self.climb} -> {cap}")
        self.climb = self.climb_from = None

    def representative_cap(self):
        """time-weighted REP_QUANTILE of the cap over the last REP_WINDOW_S of representative play,
        or None with less than REP_MIN_S of it"""
        total = sum(dt for _, _, dt in self.samples)
        if total < REP_MIN_S:
            return None
        acc = 0.0
        for cap, dt in sorted((c, d) for _, c, d in self.samples):
            acc += dt
            if acc >= REP_QUANTILE * total:
                return cap
        return None


def persist_tracker(tr, persisted):
    cap = tr.representative_cap()
    if cap:
        persist_adaptive(tr.key, cap, persisted)


def daemon():
    try:
        with open(PIDFILE) as f:
            old = int(f.read())
        with open(f"/proc/{old}/cmdline", "rb") as f:
            if b"fps-cap" in f.read() and old != os.getpid():
                print("fps-cap daemon already running", file=sys.stderr)
                return
    except (OSError, ValueError):
        pass
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    migrate()

    log(f"daemon started: min cap {MIN_CAP}, max cap {max_cap()}, margin {MARGIN}")
    cache, known, persisted, trackers = {}, {}, {}, {}   # known: run path -> (key, adaptive) of live runs
    st, tr, seq, paused = None, None, 0, "no game yet"
    changed_ns = 0
    last_frame_s, last_persist = time.monotonic(), 0.0
    window, window_s = None, 0.0
    while True:
        time.sleep(TICK)
        now_s = time.monotonic()
        runs = scan_runs(cache)

        # games that exited: save where representative play had settled
        for path in [p for p in known if p not in cache]:
            key, adaptive = known.pop(path)
            gone = trackers.pop(path, None)
            if adaptive and gone is not None:
                persist_tracker(gone, persisted)
        for r in runs:
            known[r.path] = (r.key, bool(r.flags & ADAPTIVE))

        if now_s - window_s > 1.0:
            window, window_s = hypr_active(), now_s
        tgt = pick_target(runs, window)
        if (st is not None and tgt is not None and tgt.path != st.path and st.path in cache
                and not pick_by_window(runs, window) and time.monotonic_ns() - st.last_ns < STALL_S * 1e9):
            tgt = st        # two games presenting at once: stay with the current one until it stalls
        if tgt is None:
            if st is not None:
                log("no game running")
            st, tr, paused = None, None, "no game running"
            continue
        if st is None or tgt.path != st.path:        # another game: start measuring afresh
            if tr is not None and st.path in cache and st.flags & ADAPTIVE:
                persist_tracker(tr, persisted)
            st = tgt
            tr = trackers.setdefault(st.path, Tracker(st))
            tr.reset()
            seq, changed_ns = 0, 0
            last_frame_s, last_persist = now_s, now_s
            log(f"following {st.key} (pid {st.pid}), cap {st.cap}")
            tr.start_settle(time.monotonic_ns(), f"following {st.key}")

        # an adaptive game with no cap (first launch without a saved value, or a fixed MAX_CAP that
        # the layer could not resolve) starts at the ceiling; lowering is immediate, raising is slow
        if st.flags & ADAPTIVE and st.cap <= 0:
            cap_start = st.set_cap(max_cap())
            changed_ns = time.monotonic_ns()
            log(f"{st.key} started adaptive and uncapped: cap set to {cap_start} (MAX_CAP)")

        prev_seq = seq
        new, seq, pid = st.frames_since(seq)
        if seq != prev_seq:
            last_frame_s = now_s
        if seq < prev_seq:                           # restarted under the same path
            tr.reset()
            changed_ns = 0

        why = None
        if not st.flags & ADAPTIVE:
            why = "manual mode"
        elif now_s - last_frame_s > STALL_S:
            why = "no new frames"
        elif not_fullscreen(window):
            why = "active window is not fullscreen"
        if why:
            tr.end_climb(st.cap, "stopped (paused)")
            tr.reset()
            if why != paused and why != "manual mode":
                log(f"paused: {why}")
                if st.flags & ADAPTIVE:
                    persist_tracker(tr, persisted)
            paused = why
            continue
        if paused:
            if paused != "manual mode":
                log(f"resumed {st.key}, cap {st.cap}")
                tr.start_settle(time.monotonic_ns(), f"resumed after pause: {paused}")
            paused = None
        if now_s - last_persist >= PERSIST_S:
            persist_tracker(tr, persisted)
            last_persist = now_s

        now_ns = time.monotonic_ns()  # CLOCK_MONOTONIC, the layer's clock for present_ns
        for f in new:
            if f[1] > BREAK_MS * 1e6:   # alt-tab, minimised, loading: not part of the scene, start over
                tr.end_climb(st.cap, "stopped (frame gap)")
                tr.frames, tr.in_stretch, tr.above_since = [], False, None
                tr.start_settle(now_ns, f"frame gap of {f[1] / 1e6:.0f} ms")
            else:
                tr.frames.append(f)
        tr.frames = [f for f in tr.frames if f[0] > now_ns - TAIL_LONG * 1e9]
        tr.cap_changes = [c for c in tr.cap_changes if c[0] > now_ns - 5e9]
        cap = st.cap

        # Unrepresentative stretch (loading, login, zoning, menus with stalls): the game delivers
        # under half the cap. Decide nothing and keep those frames out of both tail windows.
        last_second = sorted(f[1] for f in tr.frames if f[0] > now_ns - 1e9 and f[1] > 0)
        if last_second:
            median_ms = last_second[len(last_second) // 2] / 1e6
            unrep = median_ms > UNREP_FACTOR * 1000 / cap and median_ms > UNREP_MIN_MS
            if unrep and not tr.in_stretch:
                start = now_ns - 1e9               # the window that revealed it
                tr.in_stretch = True
                if tr.settling:
                    tr.settling = False
                    log("settle interrupted by an unrepresentative stretch")
                tr.end_climb(cap, "stopped (unrepresentative stretch)")
                # the detection lags by up to a second: undo drops it caused meanwhile
                lowered = [c for c in tr.cap_changes if c[0] > start]
                if lowered and lowered[0][1] > cap:
                    cap = st.set_cap(lowered[0][1])
                    changed_ns = now_ns
                    log(f"restored cap {cap}: drop made while the stretch was starting")
                log(f"unrepresentative stretch: median present interval {median_ms:.1f} ms is over "
                    f"{UNREP_FACTOR:g}x the {1000 / cap:.1f} ms cap interval and over {UNREP_MIN_MS:g} ms; deciding nothing")
            elif not unrep and tr.in_stretch:
                tr.in_stretch = False
                log(f"representative again (median present interval {median_ms:.1f} ms)")
                tr.start_settle(now_ns, "unrepresentative stretch ended")
        if tr.in_stretch:
            tr.above_since = None
            tr.last_sample_ns = None
            continue

        if tr.settling and now_ns >= tr.settle_until:
            tr.settling = False
            log("settled")

        def late_backup(frame_list):
            """frames actually arriving modestly late under the current cap: (fraction late, cap
            just under what the game achieved, or None when fewer than DROP_AT of them are late)"""
            recent = [f[1] / 1e6 for f in frame_list if f[0] > max(now_ns - 1e9, changed_ns)]
            interval = 1000 / cap
            late = sum(interval * LATE_FACTOR + LATE_SLACK_MS < v < interval * HITCH for v in recent) / max(len(recent), 1)
            if len(recent) >= 20 and late >= DROP_AT and cap > MIN_CAP:
                return late, int(1000 / (sum(recent) / len(recent)) * 0.96)
            return late, None

        if tr.settling:
            # Settling after a transition: nothing is measured and nothing climbs. The cap may drop
            # only through the late-frame backup, i.e. frames really arriving late under it.
            tr.end_climb(cap, "stopped (settling)")
            late, backup = late_backup(tr.frames)
            if backup is not None and backup < cap:
                new_cap = st.set_cap(backup)
                if new_cap != cap:
                    log(f"{cap} -> {new_cap}: {late:.0%} late (while settling)")
                    tr.cap_changes.append((now_ns, cap, new_cap))
                    changed_ns = now_ns
            continue

        frames = tr.representative()
        dt = min((now_ns - tr.last_sample_ns) / 1e9, 1.0) if tr.last_sample_ns else TICK
        tr.last_sample_ns = now_ns
        tr.samples.append((now_ns, cap, dt))
        tr.samples = [x for x in tr.samples if x[0] > now_ns - REP_WINDOW_S * 1e9]
        if len(frames) < 60:
            continue

        def tail(seconds, q):
            work = sorted(f[2] / 1e6 for f in frames if f[0] > now_ns - seconds * 1e9 and f[2] / 1e6 < LOADING_MS)
            return work[min(len(work) - 1, int(len(work) * q))] if len(work) >= 10 else None

        long_tail, short_tail = tail(TAIL_LONG, TAIL_LONG_Q), tail(TAIL_SHORT, TAIL_SHORT_Q)
        if long_tail is None:
            continue
        worst = max(long_tail, short_tail or 0)
        target = max(MIN_CAP, min(max_cap(), int(1000 / (worst * MARGIN))))

        late, backup = late_backup(frames)
        if backup is not None:
            target = min(target, backup)

        new_cap = None
        if target < cap:
            new_cap, why = st.set_cap(target), "tail grew" if late < DROP_AT else f"{late:.0%} late"
            tr.above_since = None
            tr.end_climb(cap, "interrupted by a drop")
        elif target > cap:
            far = target - cap >= CLIMB_FAR_GAP
            hold, step = (RISE_HOLD_FAR, RISE_STEP_FAR) if far else (RISE_HOLD, RISE_STEP)
            tr.above_since = tr.above_since or now_ns
            if (now_ns - tr.above_since) / 1e9 >= hold:
                if tr.climb_from is None:
                    tr.climb_from = tr.above_since + int(hold * 1e9)
                steps = int((now_ns - tr.climb_from) / (step * 1e9))
                if steps >= 1:
                    steps = min(steps, target - cap)
                    new_cap = st.set_cap(cap + steps)
                    tr.climb_from += int(steps * step * 1e9)
                    if tr.climb is None:
                        tr.climb = cap
                        log(f"climbing {cap} -> {target}: p99/30s {long_tail:.1f} ms, "
                            f"p95/2s {short_tail or 0:.1f} ms")
        else:
            tr.above_since = None
            tr.end_climb(cap, "reached the target")
        if new_cap is not None and new_cap != cap:
            if tr.climb is None:               # a drop: one line each
                log(f"{cap} -> {new_cap}: {why}; p99/30s {long_tail:.1f} ms, p95/2s {short_tail or 0:.1f} ms, target {target}")
            tr.cap_changes.append((now_ns, cap, new_cap))
            changed_ns = now_ns


# --- commands -------------------------------------------------------------------------------

def resolve(game, cache):
    """(key, run or None) the command applies to; exits when there is no game"""
    runs = scan_runs(cache)
    if game:
        if not valid_key(game):
            sys.exit(f"fps-cap: invalid game key {game!r}")
        mine = [r for r in runs if r.key == game]
        return game, (max(mine, key=lambda r: r.last_ns) if mine else None)
    run = pick_target(runs, hypr_active())
    if run is None:
        sys.exit("fps-cap: no game is running with framepace (use --game KEY to change saved settings)")
    return run.key, run


def cmd_cap(key, run, cap, manual_off=False):
    """manual cap (or off) for a game: live state and saved settings"""
    if manual_off:
        if run:
            run.set_mode(adaptive=False)
            run.set_raw_cap(0)
        write_conf(key, {"mode": "off"})
        return 0
    cap = clamp_cap(cap)
    if run:
        run.set_mode(adaptive=False)
        run.set_cap(cap)
    write_conf(key, {"mode": "manual", "cap": cap})
    return cap


def current_cap(key, run):
    if run and run.cap:
        return run.cap
    mode, cap, _, last = effective_settings(key)
    return cap or last or max_cap()      # from "off", start at the ceiling


def describe(key, run):
    mode, cap, overlay, last = effective_settings(key)
    if run:
        cap_now = run.cap
        flags = run.flags
        return (f"{key}: {run.mode()}, cap {cap_now if cap_now else 'off'}, overlay {'on' if flags & OVERLAY else 'off'}, "
                f"frames {run.seq} (pid {run.pid}, running), limits {MIN_CAP}-{max_cap()}")
    cap_txt = f", cap {cap}" if mode == "manual" and cap else ""
    last_txt = f", last adaptive {last}" if last else ""
    return f"{key}: not running; saved: {mode}{cap_txt}, overlay {'on' if overlay else 'off'}{last_txt}"


def cmd_list(cache):
    runs = sorted(scan_runs(cache), key=lambda r: r.key)
    target = pick_target(runs, hypr_active())
    print("running:" if runs else "no game running")
    for r in runs:
        fps = r.recent_fps()
        fps_txt = f"{fps:.1f} fps" if fps else "idle"
        cap = r.cap
        print(f"  {'*' if r is target else ' '} {r.key:<24} pid {r.pid:<8} {r.mode():<8} "
              f"cap {cap if cap else 'off':<4} overlay {'on' if r.flags & OVERLAY else 'off':<3} {fps_txt}")
    running = {r.key for r in runs}
    rest = [k for k in saved_keys() if k not in running]
    if rest:
        print("saved:")
        for k in rest:
            mode, cap, overlay, last = effective_settings(k)
            extra = (f" cap {cap}" if mode == "manual" and cap else "") + (f" last_adaptive {last}" if last else "")
            print(f"    {k:<24} {mode}{extra} overlay {'on' if overlay else 'off'}")
    print(f"limits {MIN_CAP}-{max_cap()}  (* = target of commands and the daemon)")


def main(argv):
    args = argv[1:]
    if any(a in ("-h", "--help", "help") for a in args):
        print(__doc__)
        return 0
    game = None
    if "--game" in args:
        i = args.index("--game")
        if i + 1 >= len(args):
            print(__doc__, file=sys.stderr)
            return 2
        game = args[i + 1]
        del args[i:i + 2]
    cmd = args[0] if args else "status"
    load_config()
    migrate()
    cache = {}
    if cmd == "daemon":
        daemon()            # not inside the usage-error handler below: show real tracebacks
        return 0
    try:
        if cmd == "list":
            cmd_list(cache)
        elif cmd == "status":
            runs = scan_runs(cache)
            if game or runs:
                key, run = resolve(game, cache)
                print(describe(key, run))
            else:
                print(f"no game running, limits {MIN_CAP}-{max_cap()}")
        elif cmd in ("up", "down", "set", "off", "adaptive", "overlay"):
            key, run = resolve(game, cache)
            if cmd in ("up", "down"):
                n = int(args[1]) if len(args) > 1 else 1
                cmd_cap(key, run, current_cap(key, run) + (n if cmd == "up" else -n))
            elif cmd == "set":
                cmd_cap(key, run, int(args[1]))
            elif cmd == "off":
                cmd_cap(key, run, 0, manual_off=True)
            else:
                want = args[1] if len(args) > 1 else "toggle"
                if want not in ("on", "off", "toggle"):
                    raise ValueError(want)
                mode, cap, overlay, last = effective_settings(key)
                if cmd == "adaptive":
                    now_on = bool(run.flags & ADAPTIVE) if run else mode == "adaptive"
                    on = {"on": True, "off": False}.get(want, not now_on)
                    if run:
                        run.set_mode(adaptive=on)
                    if on:
                        write_conf(key, {"mode": "adaptive"})
                    else:
                        keep = run.cap if run and run.cap else cap
                        write_conf(key, {"mode": "manual" if keep else "off"})
                        if keep:
                            write_conf(key, {"cap": keep})
                    notify(f"FPS cap {key}: {'adaptive' if on else 'manual'} ({run.cap if run else 'saved'})")
                else:
                    now_on = bool(run.flags & OVERLAY) if run else overlay
                    on = {"on": True, "off": False}.get(want, not now_on)
                    if run:
                        run.set_flags(on=OVERLAY if on else 0, off=0 if on else OVERLAY)
                    write_conf(key, {"overlay": "on" if on else "off"})
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except (IndexError, ValueError):
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(130)
